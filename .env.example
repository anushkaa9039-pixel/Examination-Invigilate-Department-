# GEMINI_API_KEY: Optional for live Gemini AI question generation.
# AI Studio automatically injects this at runtime from user secrets.
# When running locally or exporting, provide your Gemini API key from https://aistudio.google.com/app/apikey
# If left blank, the app will seamlessly use the built-in offline academic synthesizer.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Persistent storage (REQUIRED on Vercel) ---
# Vercel serverless functions cannot keep files, so exams/results are stored in Upstash Redis.
# In Vercel: Project -> Storage -> Marketplace -> Upstash Redis -> Connect to project.
# That automatically adds KV_REST_API_URL and KV_REST_API_TOKEN (these names are supported too).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
